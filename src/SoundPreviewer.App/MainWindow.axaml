<Window x:Class="SoundPreviewer.App.MainWindow"
 xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:SoundPreviewer.App"
 Title="{DynamicResource text_A46CD72AC190AA48}" Width="1380" Height="900" MinWidth="1040" MinHeight="700"
 Opened="Window_Loaded" Closing="Window_Closing">
 <Grid Background="{DynamicResource WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="118"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Border x:Name="MainToolbar" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="{DynamicResource SelectionBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Width="36" Height="36" CornerRadius="7" Margin="0,0,10,0">
      <Path Data="M 3,9 L 3,15 M 8,4 L 8,20 M 13,0 L 13,24 M 18,6 L 18,18 M 23,10 L 23,14" Stroke="{DynamicResource Accent}" StrokeThickness="2" Width="23" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock x:Name="AppBrandName" Text="SoundPreviewer" FontFamily="Segoe UI, PingFang SC, Microsoft YaHei UI" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="AppearanceButton" Classes="compact" Click="Appearance_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{DynamicResource text_C98C975919BF9DF0}" AutomationProperties.Name="{DynamicResource text_C95FFAB374B97707}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" Spacing="5"><Path Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 L14,22 C16,22 17,20 15,18 C14,17 15,15 17,15 L19,15 C23,15 23,10 21,7 C19,4 16,2 12,2 Z M7,9 L7,9.1 M12,6 L12,6.1 M17,8 L17,8.1" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource text_2AE75E16812360BE}"/></StackPanel></Button>
     <Button Classes="compact" x:Name="ScanPluginsButton" Click="ScanPlugins_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{DynamicResource text_C4F18533324FEEE6}" AutomationProperties.Name="{DynamicResource text_CA4885D44840998A}"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource text_A6F2F31C3132A444}"/></StackPanel></Button>
     <Button Classes="compact" x:Name="ScanPresetsButton" Click="Scan_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{DynamicResource text_CB447967FA691267}" AutomationProperties.Name="{DynamicResource text_68B0BBD5969511CB}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource text_B6618896EA328202}"/></StackPanel></Button>
     <CheckBox FontSize="12" x:Name="ForceGeneration" Content="{DynamicResource text_A6503ECA3A13B590}" IsChecked="False" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip.Tip="{DynamicResource text_42C28B874E4A54C4}" AutomationProperties.Name="{DynamicResource text_EE1316B633B96F23}"/>
     <Button x:Name="RenderCurrentFilterButton" Classes="compact primary" Click="Render_Click" IsEnabled="{Binding CanRenderFiltered}" ToolTip.Tip="{DynamicResource text_9680606283656459}" AutomationProperties.Name="{DynamicResource text_4C8595CA75493873}"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource text_8274F0DF56B726D2}"/></StackPanel></Button>
     <Button Classes="compact" x:Name="StopTaskButton" Click="StopTask_Click" IsEnabled="{Binding CanStopTask}" ToolTip.Tip="{DynamicResource text_CA27A8837D28F944}" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="■" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource text_CA4D973C0B006B75}"/></StackPanel></Button>
    </StackPanel>
   </Grid>
  </Border>
  <TabControl x:Name="Pages" Grid.Row="1" Margin="20,6,20,0" BorderThickness="0" Background="Transparent">
   <TabItem x:Name="LibraryTab" Header="{DynamicResource text_27D2CBD9672D810F}">
    <Grid x:Name="LibraryWorkspace" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="3.5*"/><ColumnDefinition Width="*" MinWidth="228" MaxWidth="270"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="102"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid x:Name="FilterStrip" Classes="filter-strip" Grid.ColumnSpan="2" Height="38" Margin="0,4,0,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/><ColumnDefinition Width="108"/><ColumnDefinition Width="34"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Watermark="{DynamicResource text_DC922CD8E4F25797}" TextChanged="Filter_Changed" Margin="0,0,6,0" ToolTip.Tip="{DynamicResource text_0130E9895C137AB5}" AutomationProperties.Name="{DynamicResource text_4BC792C2341E68B4}"/>
      <ItemsControl x:Name="FilterTabs" Grid.Column="1" ItemsSource="{Binding FilterGroups}" VerticalAlignment="Center" Margin="0,0,6,0">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><ToggleButton Classes="filter-tab" Content="{local:UiText DisplayLabel}" IsChecked="{Binding IsActive, Mode=OneWay}" Click="FilterGroup_Click" ToolTip.Tip="{DynamicResource text_C6FACBEF762045F0}" AutomationProperties.Name="{local:UiText Label}"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="ClearFiltersButton" Grid.Column="2" Classes="icon compact" Content="↺" Click="ClearFilters_Click" Width="26" Margin="0,0,6,0" ToolTip.Tip="{DynamicResource text_EF9B55585D2A98B6}" AutomationProperties.Name="{DynamicResource text_EF9B55585D2A98B6}"/>
      <Button x:Name="RenderFilteredButton" Grid.Column="3" Classes="compact" Content="{DynamicResource text_F84DDBBA37146E3A}" Click="RenderFiltered_Click" IsEnabled="{Binding CanRenderFiltered}" ToolTip.Tip="{DynamicResource text_88F7CCB97312FC7E}"/>
      <Button x:Name="ColumnsButton" Grid.Column="4" Classes="icon compact" Content="☷" Click="ShowColumns_Click" Width="28" Margin="0,0,6,0" ToolTip.Tip="{DynamicResource text_23F3CAA2D696F897}" AutomationProperties.Name="{DynamicResource text_F5DC1AEF4A6FCD45}"><Button.ContextMenu><ContextMenu x:Name="ColumnsMenu" Opened="ColumnMenu_Opened"/></Button.ContextMenu></Button>
      <Button Grid.Column="5" Classes="icon compact" Content="?" Width="26" Margin="0" ToolTip.Tip="{Binding #PresetFormatHint.Text}" AutomationProperties.Name="{DynamicResource text_911FFB3861899FD6}"/>
      <TextBlock x:Name="PresetFormatHint" IsVisible="False" Text="{DynamicResource text_1DC9C05C93C41144}"/>
     </Grid>
     <Border x:Name="FilterOptionsBand" Grid.Row="1" Grid.ColumnSpan="2" Height="96" Padding="12,5" Margin="0,0,0,6" Background="{DynamicResource OptionsBandBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7">
      <Grid ColumnDefinitions="62,*">
       <StackPanel Margin="0,4,6,0"><TextBlock Text="{local:UiText ActiveFilterLabel}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource text_4714B033A1296E40}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" ToolTip.Tip="{DynamicResource text_5E369D58EBA9D18A}"/></StackPanel>
       <ScrollViewer x:Name="FilterOptionsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="FilterOptionsItems" ItemsSource="{Binding ActiveFilterOptions}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><ToggleButton Classes="filter-option" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="FilterOption_Click" ToolTip.Tip="{Binding LocalizedToolTip}" AutomationProperties.Name="{local:UiText Label}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding LocalizedDisplayLabel}" TextTrimming="CharacterEllipsis" MaxWidth="230" VerticalAlignment="Center"/><Border Classes="filter-count" CornerRadius="3" Padding="5,0" Margin="5,0,0,0"><TextBlock Text="{Binding CountLabel}" FontSize="11" VerticalAlignment="Center"/></Border></StackPanel></ToggleButton></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
      </Grid>
     </Border>
     <Grid x:Name="LibraryListPane" Grid.Row="2" Margin="0,0,12,0">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
      <Grid>
       <DataGrid RowHeight="34" ColumnHeaderHeight="34" FontSize="13" x:Name="PresetGrid" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Line}" ItemsSource="{Binding PresetsView}" IsReadOnly="True" SelectionChanged="Preset_SelectionChanged" DoubleTapped="Preset_DoubleClick" FrozenColumnCount="1" CanUserReorderColumns="True" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        
        <DataGrid.ContextMenu><ContextMenu Opened="ColumnMenu_Opened"/></DataGrid.ContextMenu>
        <DataGrid.Columns>
         <DataGridTextColumn Header="{DynamicResource text_A5BD8F0C25FD508B}" Binding="{Binding Name}" Width="*" MinWidth="180"/>
         <DataGridTextColumn Header="{DynamicResource text_1FBB55C11DFD292B}" Binding="{local:UiText SynthLabel}" Width="110"/>
         <DataGridTextColumn Header="{DynamicResource text_7EC0F8668886616D}" Binding="{Binding Package}" Width="190" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_0D12CBD6562BFBFF}" Binding="{Binding CategoryTagsLabel}" Width="200"/>
         <DataGridTemplateColumn Header="{DynamicResource text_6320B4A8722A851F}" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Border Classes="status-badge" Classes.failed="{Binding IsFailed}" Classes.generated="{Binding IsGenerated}" Classes.rendering="{Binding IsRendering}"><TextBlock Text="{local:UiText StatusLabel}"/></Border>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="{DynamicResource text_8B2106CA13719CB2}" Binding="{local:UiText FeedbackLabel}" Width="72" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_60A53514EB9228A2}" Binding="{Binding FavoriteLabel}" Width="80"/>
         <DataGridTextColumn Header="{DynamicResource text_04A95E0654D3CEC7}" Binding="{local:UiText DurationLabel}" Width="85" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_5C04175C4536C882}" Binding="{Binding RenderedLabel}" Width="150" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_8468FA2BA675CAD8}" Binding="{Binding PluginVersionLabel}" Width="120" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_979A332955C855BF}" Binding="{local:UiText Message}" Width="360" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_BB29C588DDCDCC95}" Binding="{local:UiText LastRenderMessageLabel}" Width="360" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_1D0FD5F9336D9103}" Binding="{Binding TagsLabel}" Width="230" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_1CF9462AADE82ABC}" Binding="{Binding SourceLabel}" Width="320" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_B93A17BD4BF1FEBD}" Binding="{Binding SourcePathLabel}" Width="380" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_2C3FBD1CD627AE06}" Binding="{Binding AdapterVersionLabel}" Width="220" IsVisible="False"/>
         <DataGridTextColumn Header="{DynamicResource text_5783215562F24B5E}" Binding="{Binding Record.ContentMd5}" Width="290" IsVisible="False"/>
        </DataGrid.Columns>
       </DataGrid>
       <ScrollViewer x:Name="EmptyPresetState" IsVisible="{Binding EmptyVisibility}" Margin="0,36,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
        <TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" FontSize="38" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="{local:UiText EmptyMessage}" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <Button Content="{DynamicResource text_002691E0C9E27A0A}" Click="AddSourceFromLibrary_Click" Margin="0,20,0,0" IsEnabled="{Binding IsIdle}" IsVisible="{Binding EmptyLibraryVisibility}"/>
        <Button Content="{DynamicResource text_657D9CBF45EC9E6A}" Click="ClearFilters_Click" Margin="0,20,0,0" IsVisible="{Binding EmptyFilterVisibility}"/>
       </StackPanel>
       </ScrollViewer>
      </Grid>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock Text="{local:UiText LibrarySummary}" ToolTip.Tip="{local:UiText LibrarySummary}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><CheckBox x:Name="ShowDuplicates" Grid.Column="1" Content="{DynamicResource text_4131486A0EA87584}" ToolTip.Tip="{DynamicResource text_E1E8D47BA16AFEE4}" VerticalAlignment="Center" IsCheckedChanged="Filter_Changed" AutomationProperties.Name="{DynamicResource text_4131486A0EA87584}"/></Grid>
     </Grid>
     <Border x:Name="LibraryDetailsPane" Classes="preset-details card" Grid.Row="2" Grid.Column="1" Padding="14,14,0,0" Margin="0,0,0,26">
      <ScrollViewer x:Name="PresetDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="PresetDetailsContent" Margin="0,0,12,0">
        <TextBlock Text="{DynamicResource text_920502F3B87A81FD}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding Selected.Name, TargetNullValue=未选择音色, FallbackValue=未选择音色}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,10"><TextBlock Text="{local:UiText Selected.SynthLabel}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><Border Grid.Column="1" Classes="status-badge" Classes.failed="{Binding Selected.IsFailed}" Classes.generated="{Binding Selected.IsGenerated}" Classes.rendering="{Binding Selected.IsRendering}"><TextBlock Text="{local:UiText Selected.StatusLabel}"/></Border></Grid>
        <SelectableTextBlock x:Name="PresetResultDescription" Text="{local:UiText Selected.Message}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
         <Button x:Name="FavoriteButton" Classes="icon" Content="☆" Click="Favorite_Click" ToolTip.Tip="{DynamicResource text_2045BD211A75D25E}" IsEnabled="{Binding CanEditSelection}"/>
         <Button Classes="icon" Content="＋" Click="Like_Click" ToolTip.Tip="{DynamicResource text_8993762DAF037182}" IsEnabled="{Binding CanEditSelection}"/>
         <Button Classes="icon" Content="−" Click="Dislike_Click" ToolTip.Tip="{DynamicResource text_C84C47C9771793F2}" IsEnabled="{Binding CanEditSelection}"/>
        </StackPanel>
        <WrapPanel Margin="0,8,0,0">
         <Button x:Name="CopyPresetPathButton" Classes="compact" Content="{DynamicResource text_63C2ECF4850252DC}" Click="CopyPresetPath_Click" IsEnabled="{Binding CanCopyPresetPath}" Margin="0,0,6,4" ToolTip.Tip="{local:UiText PresetCopyHint}" AutomationProperties.Name="{DynamicResource text_B34841D1B3CB3F5E}"/>
         <Button x:Name="LocatePresetButton" Classes="compact" Content="{local:UiText LocatePresetLabel}" Click="Locate_Click" IsEnabled="{Binding CanLocatePreset}" Margin="0,0,0,4" AutomationProperties.Name="{DynamicResource text_8DB61BBFD971E7EE}" ToolTip.Tip="{local:UiText LocatePresetToolTip}"/>
        </WrapPanel>
        <TextBlock Text="{local:UiText PresetCopyHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <ItemsControl ItemsSource="{Binding Selected.CategoryLabels}" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="metadata-chip"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <ItemsControl ItemsSource="{Binding Selected.TagLabels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="metadata-chip"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button Content="{DynamicResource text_E44FF72259DAEB76}" Click="EditPresetMetadata_Click" IsEnabled="{Binding CanEditSelection}" Margin="0,8,0,0" Padding="10,6"/>
        <Expander x:Name="PresetMetadataExpander" Header="{DynamicResource text_DB5C6D117C9D0314}" IsExpanded="False" Margin="0,16,0,0" HorizontalContentAlignment="Stretch">
         <StackPanel IsEnabled="{Binding CanEditSelection}">
          <TextBlock Text="{DynamicResource text_515559957FD3ACBD}" Classes="field-label"/>
          <TextBox x:Name="PresetCategoriesEditor" Watermark="{DynamicResource text_FA2EFEE0B4852993}" TextChanged="MetadataSearch_Changed" AutomationProperties.Name="{DynamicResource text_EDB0727D428A5E81}"/>
          <ListBox ItemsSource="{Binding CategoryOptions}" Height="150" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
           <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0"/><Button Grid.Column="1" Content="⋯" Click="EditCategory_Click" ToolTip.Tip="{DynamicResource text_AB82411C4C628451}" Padding="5,2" Margin="0"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Button Content="{DynamicResource text_351398E236A650CB}" Click="AddCategory_Click" Margin="0,4,0,0" Padding="10,6"/>
          <TextBlock Text="{DynamicResource text_1D0FD5F9336D9103}" Classes="field-label"/>
          <TextBox x:Name="PresetTagsEditor" Watermark="{DynamicResource text_110C31E06A079A95}" TextChanged="MetadataSearch_Changed" AutomationProperties.Name="{DynamicResource text_A75351D36A4C8411}"/>
          <ListBox x:Name="TagOptionsList" ItemsSource="{Binding TagOptions}" Height="120" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
           <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0"/><Button Grid.Column="1" Content="⋯" Click="EditTag_Click" ToolTip.Tip="{DynamicResource text_AB82411C4C628451}" Padding="5,2" Margin="0"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Button Content="{DynamicResource text_10861D5210ACB41E}" Click="AddTag_Click" Margin="0,4,0,0" Padding="10,6"/>
          <TextBlock Text="{DynamicResource text_3067178A88F52EBF}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8"/>
          <WrapPanel><Button Content="{DynamicResource text_991BB7CFE5A81550}" Click="SavePresetMetadata_Click" Padding="10,6"/><Button Content="{DynamicResource text_8836276C613CABFC}" Click="ResetPresetMetadata_Click" Padding="10,6" Margin="0"/></WrapPanel>
         </StackPanel>
        </Expander>
        <TextBlock Text="{DynamicResource text_E69968577D339CB7}" Classes="field-label"/><TextBlock Text="{local:UiText Selected.LastRenderOutcomeLabel}"/><SelectableTextBlock x:Name="PresetLastResultDescription" Text="{local:UiText Selected.LastRenderMessageLabel}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
        <Button x:Name="CopyPresetResultButton" Content="{DynamicResource text_71B0BB1E27AD7887}" Click="CopyPresetResult_Click" IsEnabled="{Binding HasSelection}" Margin="0,8,0,0" ToolTip.Tip="{DynamicResource text_17425054E035F828}"/>
        <TextBlock Text="{DynamicResource text_A488E93D69CC1296}" Classes="field-label"/><TextBox Text="{Binding Selected.Record.SourcePath}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"/>
        <TextBlock Text="{Binding Selected.Record.InternalPath}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/>
        <TextBlock Text="{DynamicResource text_5783215562F24B5E}" Classes="field-label"/><TextBox Text="{Binding Selected.Record.ContentMd5}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0"/>
        <TextBlock Text="{local:UiText Selected.DuplicateLabel}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
        <Button Content="{DynamicResource text_844235AC1C332A63}" Click="ViewCanonical_Click" IsEnabled="{Binding CanViewCanonical}" IsVisible="{Binding CanonicalVisibility}" Margin="0,6,0,0"/>
        <TextBlock Text="{DynamicResource text_AD71CD06CEF073B7}" Classes="field-label"/><TextBlock Text="{local:UiText Selected.Record.DetectionReason}" TextWrapping="Wrap"/>

        <TextBlock Text="{DynamicResource text_9A947BD8E6364BA2}" Classes="field-label"/>
        <ComboBox x:Name="AssignmentSynthChoice" ItemsSource="{Binding SynthChoices}" DisplayMemberBinding="{local:UiText Label}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Selected.Record.Synth, Mode=OneWay}" IsEnabled="{Binding CanAssignSynth}" AutomationProperties.Name="{DynamicResource text_CC9DB222613276E3}"/>
        <Button Content="{DynamicResource text_5E593C06A05B07AF}" Click="AssignSynth_Click" IsEnabled="{Binding CanAssignSynth}" Margin="0,8,0,0"/>
        <TextBlock Text="{DynamicResource text_13D61FEA9F174905}" Classes="field-label"/><TextBlock Text="{local:UiText Selected.AudioLabel}" TextWrapping="Wrap"/>
        <TextBlock Text="{local:UiText Selected.QualityLabel}" Foreground="{DynamicResource Warning}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource text_8468FA2BA675CAD8}" Classes="field-label"/><TextBlock Text="{Binding Selected.Record.PluginVersion}"/>
        <Button Content="{DynamicResource text_F9454BC94E19699B}" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" Margin="0,20,0,0"/>
        <Button Content="{DynamicResource text_862F2DF34AD6070B}" Click="RenderSelected_Click" IsEnabled="{Binding CanRenderSelection}" Margin="0,8,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
   </TabItem>
   <TabItem x:Name="TasksTab" Header="{DynamicResource text_6E55E0F207BFD2E0}">
    <Grid Background="{DynamicResource Surface}" Margin="0,16,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="{DynamicResource text_4E3A3A6561E16AC1}" Click="Retry_Click" IsEnabled="{Binding CanRetryTasks}" ToolTip.Tip="{DynamicResource text_855656A888BEC0F0}"/>
      <Button Content="{DynamicResource text_D9A0929D2BFB45E4}" Click="Export_Click" IsEnabled="{Binding IsIdle}"/>
      <Button Content="{DynamicResource text_71ADEBABC9EAE434}" Click="OpenData_Click"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Text="{DynamicResource text_6E55E0F207BFD2E0}" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <ListBox Grid.Row="2" ItemsSource="{Binding Logs}" BorderThickness="0" Background="{DynamicResource SurfaceAlt}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><SelectableTextBlock Text="{local:UiText}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </TabItem>
   <TabItem x:Name="SettingsTab" Header="{DynamicResource text_FD90E585B0563259}">
    <Grid Margin="0,10,0,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TabControl x:Name="SettingsPages" BorderThickness="0" Background="{DynamicResource Surface}">
      <TabItem x:Name="DirectorySettingsTab" Header="{DynamicResource text_52DAA71EBC310581}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding Viewport.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="390">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="330"/></Grid.ColumnDefinitions>
         <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="240"/></Grid.RowDefinitions>
          <DockPanel>
           <Button x:Name="OpenDirectoryConfigurationButton" DockPanel.Dock="Right" Content="{DynamicResource text_2431DDECDFCC0602}" Click="OpenDirectoryConfiguration_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{Binding DirectoryConfigurationHint}" Padding="10,4" Margin="8,0,0,0"/>
           <TextBlock Text="{DynamicResource text_6FA6E3069CC4E2D7}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,6,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <ComboBox x:Name="SourceSynthChoice" ItemsSource="{Binding SourceChoices}" DisplayMemberBinding="{local:UiText Label}" SelectedIndex="0" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource text_EFE6556964DE06D4}"/>
           <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="{DynamicResource text_03593A6AD0533AF0}" Click="AddSource_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"/>
            <Button Content="{DynamicResource text_7743350584EE33AF}" Click="AutoDetectSource_Click" IsEnabled="{Binding IsIdle}" Padding="10,6" ToolTip.Tip="{DynamicResource text_28D0842767EC4B48}"/>
