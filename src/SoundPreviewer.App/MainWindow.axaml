           <Button x:Name="DiscoveredScanPluginsButton" Content="{DynamicResource text_A6F2F31C3132A444}" Click="ScanPlugins_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{DynamicResource text_70B15BB784A60168}"/>
