      </TabItem>
      <TabItem x:Name="DiscoveredSettingsTab" Header="{DynamicResource text_20E66E7067942B61}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding Viewport.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="365">
