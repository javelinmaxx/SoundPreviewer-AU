      <TabItem x:Name="RenderSettingsTab" Header="{DynamicResource text_83FA97899044A808}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding Viewport.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="620">
         <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*" MinWidth="330"/></Grid.ColumnDefinitions>
         <Expander x:Name="RendererSettings" Header="{DynamicResource text_4438AAC4933281EA}" IsExpanded="True" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
          <StackPanel Margin="0,0,0,10">
           <WrapPanel><Button Content="准备 Logic Patch 环境" Click="PrepareLogicPatch_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,10,6"/><Button x:Name="PrepareRendererButton" Content="{DynamicResource text_0F3045E0E26161B9}" Click="PrepareDawDreamer_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,10,6"/><TextBlock Text="{DynamicResource text_26DD140272849F5B}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6"/></WrapPanel>
           <TextBlock Text="{Binding RendererSetupLocation}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,6"/>
           <TextBlock Text="{DynamicResource text_6AEC0C4B9E459D3E}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,10">
           <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource text_D8520F1173811BA7}" VerticalAlignment="Center"/>
            <ComboBox x:Name="ParallelRendering" ItemsSource="{Binding ParallelRenderChoices}" DisplayMemberBinding="{local:UiText Label}" IsEnabled="{Binding IsIdle}" MinWidth="210" AutomationProperties.Name="{DynamicResource text_421FB6CF96FA0C40}"/>
           </StackPanel>
           <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource text_9B3B9CD888AAA100}" VerticalAlignment="Center"/>
            <ComboBox x:Name="MemoryBudgetBox" ItemsSource="{Binding MemoryBudgetChoices}" DisplayMemberBinding="{local:UiText Label}" IsEnabled="{Binding IsIdle}" MinWidth="210" AutomationProperties.Name="{DynamicResource text_CA88556EF4708C66}"/>
           </StackPanel>
           <TextBlock Text="{DynamicResource text_B1874CE29879FDB3}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/>
           <TextBlock Text="{DynamicResource text_422B200E7FB99592}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <DataGrid x:Name="PluginGrid" Grid.Row="2" ItemsSource="{Binding Plugins}" MinHeight="260" RowHeight="42" IsReadOnly="False" IsEnabled="{Binding IsIdle}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
           <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource text_1FBB55C11DFD292B}" Binding="{Binding Synth}" Width="92" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="{DynamicResource text_91697A026C35D9C0}" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{StaticResource RenderBackendValues}" DisplayMemberBinding="{local:UiText Converter={StaticResource BackendLabel}}" SelectedIndex="{Binding Backend, Mode=TwoWay, Converter={StaticResource BackendIndex}}" Margin="0,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Logic AU 链近似" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding AllowLogicPatchApproximation, Mode=TwoWay}" IsEnabled="{Binding IsLogicPatch}" HorizontalAlignment="Center" ToolTip.Tip="默认开启，允许省略未解释的 Logic 通道设置。原生乐器跳过整个音色，原生音频效果省略；发送和堆栈仍不支持。"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridCheckBoxColumn Header="{DynamicResource text_25169F7BC9A9B847}" Binding="{Binding AllowParallelRendering, Mode=TwoWay}" Width="125"/>
            <DataGridTemplateColumn Header="{DynamicResource text_EFB06B9E4D232F97}" Width="300"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Classes="icon" Content="▣" Tag="{Binding}" Click="BrowsePlugin_Click" ToolTip.Tip="{DynamicResource text_737811851E0E6DBE}" Width="32" Height="30" Margin="4,0,0,0"/><TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5,4" ToolTip.Tip="{DynamicResource text_B356FA6AA4EF9DEB}"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="{DynamicResource text_92117C38A92DBF6A}" Binding="{Binding PluginPath}" Width="260" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource text_854D1DFAE55ED2AD}" Binding="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            <DataGridTextColumn Header="{DynamicResource text_BF8541E392F09F42}" Binding="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
           </DataGrid.Columns>
          </DataGrid>
          </Grid>
         </Expander>
         <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Margin="0,12,0,0"/>
         <TabControl Grid.Column="2" Margin="0,8,0,0" Background="{DynamicResource Surface}" BorderThickness="0">
          <TabItem Header="{DynamicResource text_96648E17D37C2081}">
           <Grid RowDefinitions="Auto,*">
           <TextBlock Text="{DynamicResource text_E5BF9A4653A1513A}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,10"/>
           <DataGrid x:Name="InitializationGrid" Grid.Row="1" ItemsSource="{Binding InitBaselines}" MinHeight="240" IsReadOnly="True" AutomationProperties.Name="{DynamicResource text_EB22CA07E244AE4A}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
             <DataGridTextColumn Header="{DynamicResource text_1FBB55C11DFD292B}" Binding="{Binding Synth}" Width="85"/>
             <DataGridTextColumn Header="{DynamicResource text_6320B4A8722A851F}" Binding="{Binding Status}" Width="100"/>
             <DataGridTextColumn Header="{DynamicResource text_BB7EF73495DD8A74}" Binding="{Binding Detail}" Width="*" MinWidth="140"/>
             <DataGridTemplateColumn Header="{DynamicResource text_ED31FBB483EE1B0A}" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Classes="icon" Content="↻" Click="GenerateInitBaseline_Click" Tag="{Binding}" IsEnabled="{Binding CanGenerate}" Width="32" Height="30" Margin="0,0,4,0" ToolTip.Tip="{DynamicResource text_C5ADCDD2A8F36462}"/><Button Classes="icon" Content="▶" Click="PlayInitBaseline_Click" Tag="{Binding}" IsEnabled="{Binding CanPlay}" Width="32" Height="30" Margin="0" ToolTip.Tip="{DynamicResource text_C585C518473A3150}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
           </DataGrid>
           </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource text_5C08DA81DC7A8927}">
           <DataGrid x:Name="CompatibilityGrid" ItemsSource="{Binding Compatibility}" IsReadOnly="True" MinHeight="240" RowHeight="NaN" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource text_1FBB55C11DFD292B}" Binding="{Binding Synth}" Width="90"/><DataGridTextColumn Header="{DynamicResource text_398F8AE519E0F081}" Binding="{Binding Status}" Width="110"/><DataGridTemplateColumn Header="{DynamicResource text_AFABF8F1A4AA21BB}" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{local:UiText Detail}" TextWrapping="Wrap" Margin="4,6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
          </TabItem>
         </TabControl>
        </Grid>
       </ScrollViewer>
      </TabItem>
      <TabItem x:Name="StorageSettingsTab" Header="{DynamicResource text_5FC1E584F8FF1163}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,12,0,12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="350"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="350"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{DynamicResource text_5E07F3323A110459}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <WrapPanel Margin="0,0,0,12"><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource text_3D13868593AE4EEB}" Classes="field-label"/><ComboBox x:Name="LanguageChoiceBox" ItemsSource="{Binding LanguageChoices}" DisplayMemberBinding="{Binding Name}" MinWidth="140" SelectionChanged="Language_Changed" IsEnabled="{Binding IsIdle}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource text_E8EEC11F0F995D62}" Classes="field-label"/><ComboBox x:Name="MetadataLanguageChoiceBox" ItemsSource="{Binding MetadataLanguageChoices}" DisplayMemberBinding="{local:UiText Name}" MinWidth="140" SelectionChanged="Language_Changed" IsEnabled="{Binding IsIdle}"/></StackPanel></WrapPanel>
          <CheckBox x:Name="QuickPreviewMode" Content="{DynamicResource text_2706ADAAADBE6BC5}" IsChecked="True" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8" ToolTip.Tip="{DynamicResource text_83938425C3E21727}"/>
          <StackPanel IsEnabled="{Binding #QuickPreviewMode.IsChecked}" Margin="0,0,0,8"><TextBlock Text="{DynamicResource text_4E44D96DFFB90D05}" Classes="field-label"/><TextBox x:Name="QuickPreviewSecondsBox" Text="0.5" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{DynamicResource text_40A858DE458D1363}"/><TextBlock Text="{DynamicResource text_3F0A9583CB56121A}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
          <Grid IsEnabled="{Binding IsIdle}">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <StackPanel><TextBlock Text="{DynamicResource text_78EA172F0DC1959A}" Classes="field-label"/><TextBox x:Name="LowNoteBox" Watermark="C2"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource text_42B456F91DD4B34A}" Classes="field-label"/><TextBox x:Name="MiddleNoteBox" Watermark="C4"/></StackPanel>
           <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource text_5D366102F84EF8F8}" Classes="field-label"/><TextBox x:Name="HighNoteBox" Watermark="C6"/></StackPanel>
           <StackPanel Grid.Row="1"><TextBlock Text="{DynamicResource text_905FF5C46DD1448A}" Classes="field-label"/><TextBox x:Name="VelocityBox"/></StackPanel>
           <StackPanel Grid.Row="1" Grid.Column="2" IsEnabled="{Binding !#QuickPreviewMode.IsChecked}"><TextBlock Text="{DynamicResource text_6988B07FD0F18FDC}" Classes="field-label"/><TextBox x:Name="HoldBox"/></StackPanel>
           <StackPanel Grid.Row="1" Grid.Column="4" IsEnabled="{Binding !#QuickPreviewMode.IsChecked}"><TextBlock Text="{DynamicResource text_39D73CD9C733C065}" Classes="field-label"/><TextBox x:Name="TailBox"/></StackPanel>
           <StackPanel Grid.Row="2"><TextBlock Text="BPM" Classes="field-label"/><TextBox x:Name="BpmBox"/></StackPanel>
           <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"><TextBlock Text="{DynamicResource text_9AB0D8AB78367AA4}" Classes="field-label"/><ComboBox x:Name="SampleRateBox"><ComboBoxItem Content="44100"/><ComboBoxItem Content="48000"/></ComboBox></StackPanel>
          </Grid>
          <WrapPanel Margin="0,16,0,0"><Button Content="{DynamicResource text_E17B4A9DC971CA14}" Click="VitalDefaults_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"/><TextBlock Text="{DynamicResource text_CBCDA51E7130F7C3}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="{DynamicResource text_C4FA5BCEB264FD3A}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
          <TextBlock Text="{DynamicResource text_EA2D42866B2BF962}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
          <TextBlock Text="{DynamicResource text_7F7C49ADC3FDBC64}" Classes="field-label"/>
          <ComboBox x:Name="PreviewFormatBox" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{DynamicResource text_4E2B4A526423F759}"><ComboBoxItem Content="{DynamicResource text_16FCFEAE3809DEE7}"/><ComboBoxItem Content="{DynamicResource text_242C64FCF2DF2108}"/></ComboBox>
          <TextBlock Text="{DynamicResource text_DF18AAA608771A41}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,2"/>
          <TextBlock Text="{DynamicResource text_81FFFC60D6C1510D}" Classes="field-label"/>
          <TextBox Text="{Binding LibraryLocation, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{DynamicResource text_5C88A3F326A6DBA8}" ToolTip.Tip="{Binding LibraryLocation}"/>
          <StackPanel Margin="0,4,0,0"><TextBlock Text="{DynamicResource text_9D3478C91ADD4C2A}" Classes="field-label"/><TextBox x:Name="PreviewDirectoryBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="90" ToolTip.Tip="{Binding #PreviewDirectoryBox.Text}" AutomationProperties.Name="{DynamicResource text_9ACDA844E72F057C}"/></StackPanel>
          <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsIdle}"><Button Content="{DynamicResource text_BF8192A07063C458}" Click="OpenData_Click" Padding="10,6" Margin="0,0,8,8"/><Button x:Name="CompressPreviewsButton" Content="{DynamicResource text_494F3CB63BF6DF01}" Click="CompressPreviews_Click" IsEnabled="{Binding CanCompressPreviews}" Padding="10,6" Margin="0,0,8,8" ToolTip.Tip="{DynamicResource text_44996E2D2B51DBFB}"/><Button Content="{DynamicResource text_DFF2B9D16A02FD0B}" Click="ClearPreviews_Click" Padding="10,6" Margin="0,0,0,8"/></WrapPanel>
          <Button Content="{DynamicResource text_9721050B07A2A364}" Click="OpenExistingLibrary_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,0,4" Padding="10,6" ToolTip.Tip="{DynamicResource text_7E7BCE0DF5DFA9E6}"/>
          <Grid IsEnabled="{Binding IsIdle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="{DynamicResource text_596E76782C94A0F2}" Classes="field-label"/><TextBox x:Name="BudgetBox"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource text_B40E06723D15521F}" Classes="field-label"/><TextBox x:Name="AttemptsBox"/></StackPanel>
          </Grid>
         </StackPanel>
        </Grid>
       </ScrollViewer>
      </TabItem>
      <TabItem x:Name="ClassificationSettingsTab" Header="{DynamicResource text_6E700446263DB82C}">
       <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="RulesPathBox" IsReadOnly="True" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource text_A19DFF1CF88CD54E}"/><Button Grid.Column="1" Classes="icon" Content="↗" Click="OpenCategoryRules_Click" Width="34" Height="34" Margin="0" ToolTip.Tip="{DynamicResource text_B32E70C085767A49}"/></Grid>
        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
         <Button Click="ReloadCategoryRules_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource text_35588DCB9BE3DC8E}"/></StackPanel></Button>
         <Button Click="SaveCategoryRules_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource text_A7EC01A65F094BC6}"/></StackPanel></Button>
         <Button Click="ApplyCategoryRules_Click" IsEnabled="{Binding IsIdle}" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource text_35667CEA63C1370E}"/></StackPanel></Button>
        </WrapPanel>
        <TextBox x:Name="RulesEditor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" FontFamily="Menlo, Consolas, monospace" FontSize="13" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="{Binding IsBusy}" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource text_47AE6D6BF46BCF70}"/>
        <TextBlock x:Name="ClassificationStatus" Grid.Row="3" Text="{local:UiText CategoryRulesStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" MaxHeight="48"/>
       </Grid>
      </TabItem>
     </TabControl>
     <Grid Grid.Row="1" Height="36" Margin="0,8,0,4" IsVisible="{Binding !#ClassificationSettingsTab.IsSelected}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" Click="SaveSettings_Click" Classes="primary" Margin="0" Padding="14,6" IsEnabled="{Binding IsIdle}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource text_C8550237BA701F64}"/></StackPanel></Button></Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Border x:Name="PlaybackBar" Grid.Row="2" IsVisible="{Binding !#SettingsTab.IsSelected}" Height="84" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Margin="20,4,20,4" Padding="14,6">
   
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{local:UiText NowPlaying}" FontSize="12" LineHeight="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
     <StackPanel Orientation="Horizontal">
      <Button x:Name="PlayPreviewButton" Classes="icon primary" Content="▶" Width="32" Height="28" Margin="0,0,5,0" Click="Play_Click" ToolTip.Tip="{DynamicResource text_F03E2B5312A86349}" IsEnabled="{Binding CanPlay}"/>
      <Button Classes="icon" Content="■" Width="32" Height="28" Margin="0,0,5,0" Click="Stop_Click" ToolTip.Tip="{DynamicResource text_D2514094A0F771A4}" IsEnabled="{Binding CanPlay}"/>
      <Button Content="{DynamicResource text_A567BDAA11367F26}" Click="PlayNote_Click" Tag="Middle" FontSize="12" Padding="0" Width="32" Height="28" Margin="0,0,5,0" ToolTip.Tip="{DynamicResource text_B5ED94E3C8E19CAC}" IsEnabled="{Binding CanPlay}"/>
      <Button Content="{DynamicResource text_B1C27820FEC23EDB}" Click="PlayNote_Click" Tag="High" FontSize="12" Padding="0" Width="32" Height="28" Margin="0,0,5,0" ToolTip.Tip="{DynamicResource text_6A2A2CA3D3C25026}" IsEnabled="{Binding CanPlay}"/>
      <Button Content="{DynamicResource text_AA9E366F68D3D097}" Click="PlayNote_Click" Tag="Low" FontSize="12" Padding="0" Width="32" Height="28" Margin="0,0,5,0" ToolTip.Tip="{DynamicResource text_81180C8E83246695}" IsEnabled="{Binding CanPlay}"/>
     </StackPanel>
     <Border x:Name="PreviewShortcutHint" IsVisible="{Binding #LibraryTab.IsSelected}" Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="5,1" Margin="0,4,0,0" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource text_1A961B42D73F93ED}">
      <TextBlock Text="{DynamicResource text_61C1EB23AE24F8CF}" FontSize="11" LineHeight="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
     </Border>
    </StackPanel>
    <Grid Grid.Column="1" Margin="16,0,20,0"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="18"/></Grid.RowDefinitions>
     <Border CornerRadius="5" ClipToBounds="True"><local:WaveformView x:Name="Waveform" BackgroundBrush="{DynamicResource HoverBackground}" WaveBrush="{DynamicResource Accent}" LineBrush="{DynamicResource Line}" PlayheadBrush="{DynamicResource Accent}"/></Border>
     <Slider x:Name="SeekSlider" Grid.Row="1" Minimum="0" Maximum="1" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="{DynamicResource text_CBC1B88ECBE201AC}"/>
    </Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
     <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
     <DockPanel><TextBlock Text="♪" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" AutomationProperties.Name="{DynamicResource text_471E470980DA418B}"/></DockPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="TaskStatusBand" Grid.Row="3" Height="118" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Margin="20,0" Padding="14,6" AutomationProperties.Name="{DynamicResource text_6CA36D2A45F660FA}">
   <Grid ColumnDefinitions="2.3*,16,*" RowDefinitions="24,20,18,18,18,4">
    <Grid ColumnDefinitions="*,Auto">
     <TextBlock x:Name="TaskProgressTitle" Text="{local:UiText TaskTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
     <StackPanel x:Name="TaskProgressMetadata" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="{local:UiText TaskElapsed}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
      <Button x:Name="CopyGenerationResultButton" Content="{DynamicResource text_B93A1C638AB18DF2}" Click="CopyGenerationResult_Click" FontSize="11" Height="22" MinHeight="22" Padding="6,2" Margin="0,0,5,0" ToolTip.Tip="{DynamicResource text_B2E0431C3F1417D8}"/>
      <Button Content="{DynamicResource text_B3B7E552E8763183}" FontSize="11" Click="OpenRelocatedLibrary_Click" IsVisible="{Binding RelocatedLibraryVisibility}" Margin="0,0,5,0" Padding="6,2" Height="22" MinHeight="22"/>
      <Button x:Name="ViewGeneratedButton" Content="{DynamicResource text_49F9296FB371A1EC}" FontSize="11" Click="ViewGenerated_Click" IsVisible="{Binding GeneratedResultsVisibility}" ToolTip.Tip="{DynamicResource text_9F6B55341F99065F}" Margin="0,0,5,0" Padding="6,2" Height="22" MinHeight="22"/>
      <Button Classes="icon" Content="⚙" Click="ViewTaskSettings_Click" ToolTip.Tip="{DynamicResource text_D5A18635BD677025}" IsVisible="{Binding TaskSettingsVisibility}" Width="24" Height="22" Margin="0"/>
     </StackPanel>
    </Grid>
    <TextBlock x:Name="TaskCountersText" Grid.Row="1" Text="{local:UiText TaskProgressText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{local:UiText TaskProgressText}"/>
    <TextBlock x:Name="TaskSelectionDetails" Grid.Row="2" Text="{local:UiText TaskSelectionText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" ToolTip.Tip="{local:UiText TaskSelectionText}"/>
    <SelectableTextBlock x:Name="TaskProgressDetails" Grid.Row="3" Text="{local:UiText StatusMessage}" FontSize="11" MaxHeight="18" TextTrimming="CharacterEllipsis" ToolTip.Tip="{local:UiText StatusMessage}"/>
    <TextBlock x:Name="TaskResourceDetails" Grid.Row="4" Text="{local:UiText TaskMemoryText}" IsVisible="{Binding TaskMemoryVisible}" FontSize="11" MaxHeight="18" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" ToolTip.Tip="{local:UiText TaskMemoryText}"/>
    <ProgressBar x:Name="GenerationProgressBar" Grid.Row="5" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" AutomationProperties.Name="{DynamicResource text_42907BC0335E878A}"/>
    <Grid Grid.Column="2" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource text_3E94B5600BD265E3}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource text_82B8F231ACB6A3E4}" FontSize="11" Click="ViewTasks_Click" Height="22" MinHeight="22" Padding="5,1" Margin="0" ToolTip.Tip="{DynamicResource text_8BD1B285E33FDB91}"/></Grid>
    <ListBox x:Name="RecentLogList" Classes="recent-log" Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" ItemsSource="{Binding RecentLogs}" FontSize="11" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource text_3E94B5600BD265E3}">
     <ListBox.ItemTemplate><DataTemplate><SelectableTextBlock Text="{local:UiText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{local:UiText}"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
  <Border x:Name="StatusFooter" Grid.Row="4" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,0">
   <DockPanel>
    <Button x:Name="UserGuideButton" DockPanel.Dock="Right" Click="OpenUserGuide_Click" ToolTip.Tip="{DynamicResource text_2B03CBE52E16F5D2}" AutomationProperties.Name="{DynamicResource text_25B37D5C985EA3BE}" Width="26" Height="22" MinHeight="22" Padding="4,0" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"><Path Data="M12,4 C8,1 4,2 2,3 L2,19 C5,18 8,18 12,21 C16,18 19,18 22,19 L22,3 C19,2 16,1 12,4 Z M12,4 L12,21" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
    <TextBlock x:Name="BuildVersionLabel" DockPanel.Dock="Right" Text="{local:UiText AppVersion}" ToolTip.Tip="{Binding BuildLocation}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/>
    <TextBlock x:Name="StatusFooterText" Text="{local:UiText StatusMessage}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{local:UiText StatusMessage}"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
