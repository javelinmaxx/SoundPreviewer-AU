           <Button x:Name="DirectoryScanPluginsButton" Click="ScanPlugins_Click" IsEnabled="{Binding IsIdle}" Padding="10,6" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontFamily="Arial, PingFang SC, Microsoft YaHei UI" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource text_A6F2F31C3132A444}"/></StackPanel></Button>
           <Button Classes="icon" Content="×" Click="RemovePluginDirectory_Click" IsEnabled="{Binding IsIdle}" Width="34" Height="32" Margin="0,0,0,8" ToolTip.Tip="{DynamicResource text_C2618FD3B641B525}"/>
