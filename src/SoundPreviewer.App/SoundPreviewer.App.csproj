<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>SoundPreviewer</AssemblyName>
    <X86HostDirectory Condition="'$(X86HostDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\vst2host-x86\</X86HostDirectory>
    <WorkerOutputDirectory>$(MSBuildThisFileDirectory)../SoundPreviewer.Worker/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/</WorkerOutputDirectory>
    <NormalizedX86HostDirectory>$([MSBuild]::EnsureTrailingSlash('$(X86HostDirectory)'))</NormalizedX86HostDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../UserGuide/**/*" Link="UserGuide/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../artifacts/user-guide/SoundPreviewer.chm" Link="UserGuide/SoundPreviewer.chm"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"
             Condition="Exists('../../artifacts/user-guide/SoundPreviewer.chm')" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <ProjectReference Include="../SoundPreviewer.Core/SoundPreviewer.Core.csproj" />
    <ProjectReference Include="../SoundPreviewer.Worker/SoundPreviewer.Worker.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../../scripts/Prepare-DawDreamer.ps1" Link="Prepare-DawDreamer.ps1"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true"
             Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))" />
    <Content Include="../../scripts/Prepare-DawDreamer.sh" Link="Prepare-DawDreamer.sh"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true"
             Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))" />
  </ItemGroup>
  <Target Name="CopyRenderWorker" AfterTargets="Build">
    <ItemGroup>
      <WorkerFiles Include="$(WorkerOutputDirectory)SoundPreviewer.Worker*" />
      <RendererFiles Include="$(WorkerOutputDirectory)Renderers/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="@(RendererFiles)" DestinationFiles="@(RendererFiles->'$(OutDir)Renderers/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishRenderWorker" AfterTargets="Publish">
    <PropertyGroup>
      <WorkerPublishDirectory>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)/obj/worker-publish/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)'))</WorkerPublishDirectory>
    </PropertyGroup>
    <!-- A shared PublishDir can already contain the ordinary worker apphost
         copied by the desktop build. Its timestamp must not satisfy the
         worker bundler's incremental output check. Publish independently. -->
    <Error Condition="!$([System.IO.Path]::GetFullPath('$(WorkerPublishDirectory)').StartsWith('$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)/obj/worker-publish/'))'))"
           Text="Worker publish staging must remain under this project's obj/worker-publish directory." />
    <RemoveDir Directories="$(WorkerPublishDirectory)" />
    <MSBuild Projects="../SoundPreviewer.Worker/SoundPreviewer.Worker.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=$(PublishSingleFile);IncludeNativeLibrariesForSelfExtract=$(IncludeNativeLibrariesForSelfExtract);EnableCompressionInSingleFile=$(EnableCompressionInSingleFile);PublishTrimmed=$(PublishTrimmed);PublishDir=$(WorkerPublishDirectory)" />
    <ItemGroup><PublishedWorkerFiles Include="$(WorkerPublishDirectory)**/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedWorkerFiles)" DestinationFiles="@(PublishedWorkerFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyX86Host" AfterTargets="Build" Condition="Exists('$(NormalizedX86HostDirectory)SoundPreviewer.Vst2Host.exe') and ($([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))))">
    <ItemGroup><X86HostFiles Include="$(NormalizedX86HostDirectory)**\*" /></ItemGroup>
    <Copy SourceFiles="@(X86HostFiles)" DestinationFiles="@(X86HostFiles->'$(OutDir)Vst2Host-x86\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishX86Host" AfterTargets="Publish" Condition="Exists('$(NormalizedX86HostDirectory)SoundPreviewer.Vst2Host.exe') and ($([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))))">
    <ItemGroup><PublishedX86HostFiles Include="$(NormalizedX86HostDirectory)**\*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedX86HostFiles)" DestinationFiles="@(PublishedX86HostFiles->'$(PublishDir)Vst2Host-x86\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
